{% extends 'base.html.twig' %}

{% block title %}Admin Commandes{% endblock %}

{% block body %}
<h1 class="mb-4">Liste des commandes</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Numéro</th>
            <th>Date</th>
            <th>Total</th>
            <th>Statut</th>
            <th>Client</th>
        </tr>
    </thead>
    <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id }}</td>
                <td>{{ commande.numero }}</td>
                <td>{{ commande.dateCommande|date('Y-m-d H:i') }}</td>
                <td>{{ commande.total }} TND</td>
                <td>{{ commande.statut }}</td>
                <td>{{ commande.user ? commande.user.email : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucune commande trouvée.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}