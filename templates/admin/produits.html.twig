{% extends 'base.html.twig' %}

{% block title %}Admin Produits{% endblock %}

{% block body %}
<h1 class="mb-4">Liste des produits</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prix</th>
            <th>Stock</th>
            <th>Catégorie</th>
        </tr>
    </thead>
    <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.id }}</td>
                <td>{{ produit.nom }}</td>
                <td>{{ produit.prix }} TND</td>
                <td>{{ produit.stock }}</td>
                <td>{{ produit.categorie ? produit.categorie.nom : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun produit trouvé.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}