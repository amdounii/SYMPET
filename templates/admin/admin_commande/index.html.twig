{% extends 'base.html.twig' %}

{% block title %}Admin Commandes{% endblock %}

{% block body %}
    <h1 class="mb-4">Gestion des commandes</h1>

    <table class="table table-bordered table-striped bg-white">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Numéro</th>
                <th>Client</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
                <tr>
                    <td>{{ commande.id }}</td>
                    <td>{{ commande.numero }}</td>
                    <td>{{ commande.user.nom }} {{ commande.user.prenom }}</td>
                    <td>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y H:i') : '' }}</td>
                    <td>{{ commande.statut }}</td>
                    <td>{{ commande.total }} DT</td>
                    <td>
                        <a href="{{ path('admin_commande_show', {'id': commande.id}) }}" class="btn btn-primary btn-sm">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune commande.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}