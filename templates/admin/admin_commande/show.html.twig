{% extends 'base.html.twig' %}

{% block title %}Détail commande admin{% endblock %}

{% block body %}
    <div class="card shadow-sm">
        <div class="card-body">
            <h2>Commande {{ commande.numero }}</h2>
            <p><strong>Client :</strong> {{ commande.user.nom }} {{ commande.user.prenom }}</p>
            <p><strong>Date :</strong> {{ commande.dateCommande ? commande.dateCommande|date('d/m/Y H:i') : '' }}</p>
            <p><strong>Statut :</strong> {{ commande.statut }}</p>
            <p><strong>Total :</strong> {{ commande.total }} DT</p>

            <h4 class="mt-4">Produits commandés</h4>
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th>Prix</th>
                        <th>Quantité</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in commande.ligneCommandes %}
                        <tr>
                            <td>{{ ligne.produit.nom }}</td>
                            <td>{{ ligne.prixUnitaire }} DT</td>
                            <td>{{ ligne.quantite }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <form method="post" action="{{ path('admin_commande_statut', {'id': commande.id}) }}" class="mt-3">
                <div class="mb-3">
                    <label class="form-label">Modifier le statut</label>
                    <select name="statut" class="form-select">
                        <option value="en_attente">En attente</option>
                        <option value="en_cours">En cours</option>
                        <option value="completee">Complétée</option>
                    </select>
                </div>
                <button class="btn btn-warning">Mettre à jour</button>
            </form>
        </div>
    </div>
{% endblock %}