{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Dashboard Admin</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Produits</h5>
                    <p class="card-text fs-4">{{ nombreProduits }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5 class="card-title">Catégories</h5>
                    <p class="card-text fs-4">{{ nombreCategories }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Commandes</h5>
                    <p class="card-text fs-4">{{ nombreCommandes }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-dark">
                <div class="card-body">
                    <h5 class="card-title">Clients</h5>
                    <p class="card-text fs-4">{{ nombreClients }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body">
                    <h5>Chiffre d'affaires</h5>
                    <p class="fs-4">{{ chiffreAffaires }} TND</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body">
                    <h5>Commandes en attente</h5>
                    <p class="fs-4">{{ commandesEnAttente }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <h5>Commandes complétées</h5>
                    <p class="fs-4">{{ commandesCompletees }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('app_admin_produits') }}" class="btn btn-primary">Gérer Produits</a>
        <a href="{{ path('app_admin_categories') }}" class="btn btn-success">Gérer Catégories</a>
        <a href="{{ path('app_admin_commandes') }}" class="btn btn-warning">Voir Commandes</a>
        <a href="{{ path('app_admin_users') }}" class="btn btn-dark">Voir Utilisateurs</a>
    </div>
</div>
{% endblock %}