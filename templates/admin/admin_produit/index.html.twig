{% extends 'base.html.twig' %}

{% block title %}Admin Produits{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des produits</h1>
        <a href="{{ path('admin_produit_new') }}" class="btn btn-primary">Ajouter produit</a>
    </div>

    <table class="table table-bordered table-striped bg-white">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>Stock</th>
                <th>Catégorie</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for produit in produits %}
                <tr>
                    <td>{{ produit.id }}</td>
                    <td>{{ produit.nom }}</td>
                    <td>{{ produit.prix }} DT</td>
                    <td>{{ produit.stock }}</td>
                    <td>{{ produit.categorie.nom }}</td>
                    <td>
                        <a href="{{ path('admin_produit_edit', {'id': produit.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        <a href="{{ path('admin_produit_delete', {'id': produit.id}) }}" class="btn btn-danger btn-sm">Supprimer</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun produit.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}