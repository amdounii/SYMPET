{% extends 'base.html.twig' %}

{% block body %}

<h1>{{ produit.nom }}</h1>

<img src="{{ produit.image ?? 'https://via.placeholder.com/300' }}" width="300">

<p>{{ produit.description }}</p>
<p><strong>Prix :</strong> {{ produit.prix }} TND</p>
<p><strong>Stock :</strong> {{ produit.stock }}</p>

<a href="{{ path('app_panier_add', {id: produit.id}) }}" class="btn btn-success">
    Ajouter au panier
</a>

{% endblock %}