{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h1 class="mb-4">Mon panier</h1>

    {% if items is not empty %}
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Produit</th>
                            <th>Prix</th>
                            <th>Quantité</th>
                            <th>Sous-total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.produit.nom }}</td>
                                <td>{{ item.produit.prix }} DT</td>
                                <td>{{ item.quantite }}</td>
                                <td>{{ item.sousTotal }} DT</td>
                                <td>
                                    <a href="{{ path('app_panier_add', {'id': item.produit.id}) }}" class="btn btn-success btn-sm">+</a>
                                    <a href="{{ path('app_panier_decrease', {'id': item.produit.id}) }}" class="btn btn-warning btn-sm">-</a>
                                    <a href="{{ path('app_panier_remove', {'id': item.produit.id}) }}" class="btn btn-danger btn-sm">Supprimer</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h4>Total : {{ total }} DT</h4>
                    <div>
                        <a href="{{ path('app_panier_clear') }}" class="btn btn-outline-danger">Vider</a>
                        <a href="{{ path('app_commande_valider') }}" class="btn btn-primary">Valider la commande</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Votre panier est vide.</div>
    {% endif %}
{% endblock %}